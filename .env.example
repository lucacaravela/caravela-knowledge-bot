# --- Claude API ---
# Get it at https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model (default: claude-sonnet-4-6)
# CLAUDE_MODEL=claude-sonnet-4-6

# --- Affinity CRM ---
# Settings > API in Affinity (requires admin rights). Same key works for v1 and v2.
AFFINITY_API_KEY=...

# --- Google Drive (service account) ---
# The FULL service account JSON key as a single line. Wrap in single quotes locally.
GOOGLE_SERVICE_ACCOUNT_JSON='{"type": "service_account", "project_id": "...", ...}'
# Alternative for local dev: path to the JSON key file (used if the var above is empty)
# GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

# --- Access control ---
# Only Google accounts from this email domain can use the app.
ALLOWED_DOMAIN=caravela.capital
# Optional: comma-separated list of extra emails allowed regardless of domain
# (useful for testing with personal accounts).
# ALLOWED_EMAILS=someone@gmail.com,other@example.com

# --- WhatsApp (Meta Cloud API, optional — only for the WhatsApp bot) ---
# From developers.facebook.com > your app > WhatsApp use case > API Setup
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Any string you invent; must match the one typed in the webhook config
WHATSAPP_VERIFY_TOKEN=change-me
# App secret (App settings > Basic) enables webhook signature checking
WHATSAPP_APP_SECRET=
# Comma-separated phones allowed to use the bot, digits only with country code
ALLOWED_PHONES=5511999999999,5511888888888

# --- Twilio WhatsApp (alternative to Meta while business is unverified) ---
# Console dashboard > Account Info
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# Sandbox number (default) or your production Twilio WhatsApp sender
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Google login (Streamlit native auth / OpenID Connect) ---
# OAuth client from Google Cloud Console (type: Web application).
GOOGLE_OAUTH_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...
# Any long random string (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
AUTH_COOKIE_SECRET=change-me-to-a-long-random-string
# Local dev: http://localhost:8501/oauth2callback
# Render:    https://YOUR-APP.onrender.com/oauth2callback
AUTH_REDIRECT_URI=http://localhost:8501/oauth2callback
